# Copy to .env and adjust as needed. Every value below already has a
# working default baked into docker-compose.yml / index.php /
# config/video.php — nothing here is required to set.

# --- scraper (index.php / docker-compose.yml `scraper` service) ---

# Overrides index.php's target listing page. Default matches the
# original hardcoded value.
SCRAPE_URL=https://downloadly.ir/download/elearning/video-tutorials/

# Image build label only (org.opencontainers.image.version via Dockerfile
# ARG APP_VERSION) — cosmetic, not read by any application code.
APP_VERSION=dev

# --- video-merge (bin/process.php / config/video.php) ---
# These are read directly by config/video.php via getenv(), for BOTH the
# native (Windows) tool and the docker-compose.yml `video-merge` service.
# The docker-compose service already sets VIDEO_SOURCE_DIR/VIDEO_DEST_DIR
# itself (container-internal /data/... paths — see that file) — the ones
# below matter for running bin/process.php directly on a host.

# Course library root / merged-output root. Defaults match the original
# hardcoded values (a Windows-only machine's actual layout).
#VIDEO_SOURCE_DIR=D:\Video\zip\
#VIDEO_DEST_DIR=D:\Video\Dn\

# Comma-separated course folder names (under VIDEO_SOURCE_DIR) to merge.
# Default matches the original hardcoded single-course list.
#VIDEO_FOLDERS=MSK JavaScript Bootcamp

# Path to the ffmpeg binary. Default matches the original hardcoded
# Windows path; the video-merge Docker image sets this itself (see
# Dockerfile) to the binary obtained from mwader/static-ffmpeg.
#FFMPEG_BIN=E:\DevOps\OpenServer\domains\videomerge.azp\old\ffmpeg\bin\ffmpeg.exe

# ffmpeg re-encode flags (TASK-007 — previously hardcoded in
# FfmpegCommandBuilder's call site). Defaults match the original literals.
#VIDEO_CODEC_ARGS=-c:v libx264 -s 1920x1080 -r 30 -b:v 2M
#AUDIO_CODEC_ARGS=-c:a aac -ac 2 -ar 44100 -b:a 192k

# A leftover machine-specific path prefix stripped from filenames before
# they're written into manifests/ffmpeg commands (TASK-007 — see
# RenameManifestWriter's docblock for why the default can't be
# "corrected" to VIDEO_SOURCE_DIR/VIDEO_DEST_DIR above). Only worth
# setting if your own source tree happens to share this quirk.
#LEGACY_PATH_PREFIX=D:\IDM\IDM2\tt\

# Comma-separated, case-insensitive video file extensions recognized by
# the scanner (TASK-007 — previously a hardcoded class constant). Default
# matches the original's 10-extension list.
#VIDEO_EXTENSIONS=mp4,mov,f4v,mkv,avi,wmv,mpg,flv,webm,m4v

# Which execution pipeline to use: `auto` (detect via PHP_OS_FAMILY),
# `windows` (cmd.exe + BatchScriptBuilder, the tool's original design),
# or `linux` (sh + ShellScriptBuilder, TASK-007's addition — this is what
# the video-merge Docker image sets, see Dockerfile).
#VIDEO_MERGE_PLATFORM=auto

# --- video-merge (docker-compose.yml `video-merge` service only) ---
# Host directories bind-mounted into the container's /data/source and
# /data/dest, and the course folder list for that run. Unset ->
# docker-compose.yml's own ./data/video-source, ./data/video-dest, and an
# empty folder list defaults.
#VIDEO_MERGE_SOURCE_DIR=./data/video-source
#VIDEO_MERGE_DEST_DIR=./data/video-dest
#VIDEO_MERGE_FOLDERS=my-course
