# Generated by `vendor/bin/phpstan analyse --generate-baseline` when
# PHPStan was added in TASK-007. Both entries below are the SAME
# pre-existing quirk in DirectoryScanner::scan() (lines 54/57): once
# `elseif ($value !== '.' && $value !== '..')` is reached, `is_dir($path)`
# was already true to get there, and nothing between there and the
# nested `if (is_dir($path))` can change that statically — so PHPStan
# sees that check (and the `$results[] = $path;` guarded behind it) as
# always-true / unreachable. This mirrors the DIRECTORY_SEPARATOR-based
# recursive listing logic extracted byte-for-byte from the original
# getDirContents() (see that class's docblock) — not something this
# task's PHPStan addition is meant to fix, just meant to surface. New
# code should not add entries here; fix new findings instead of
# baselining them.
parameters:
	ignoreErrors:
		-
			message: "#^If condition is always true\\.$#"
			count: 1
			path: src/Infrastructure/FileSystem/DirectoryScanner.php

		-
			message: "#^Unreachable statement \\- code above always terminates\\.$#"
			count: 1
			path: src/Infrastructure/FileSystem/DirectoryScanner.php
